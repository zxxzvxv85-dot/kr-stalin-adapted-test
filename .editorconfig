root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{txt,gui,gfx,asset}]
indent_style = tab
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[*.{js,cjs,json,yml}]
indent_style = space
indent_size = 2

[*.yml]
charset = utf-8-bom

[*.md]
trim_trailing_whitespace = false
