        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-28" parent="1" style="whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="60" width="120" x="-1820" y="11001" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-50" edge="1" parent="1" source="t5M3M1sEbG90e6OJC7N9-30" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBackgroundColor=default;defaultLabelBackgroundColor=page;startSize=8;endArrow=classic;endSize=8;" target="t5M3M1sEbG90e6OJC7N9-49">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-30" parent="1" style="whiteSpace=wrap;html=1;" value="重复海报的花费和效果提高到原先的1.5倍" vertex="1">
          <mxGeometry height="60" width="120" x="-2860" y="11061.14" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-34" edge="1" parent="1" source="t5M3M1sEbG90e6OJC7N9-37" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBackgroundColor=default;defaultLabelBackgroundColor=page;startSize=8;endArrow=classic;endSize=8;" target="t5M3M1sEbG90e6OJC7N9-32">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-2740" y="11166" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-35" parent="1" style="whiteSpace=wrap;html=1;" value="获得持续180天的群众犹豫不决，减少热情&lt;div&gt;到期后变成群众热情澎湃。&lt;/div&gt;&lt;div&gt;所有海报花费减半&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="-1820" y="11121" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-36" parent="1" style="whiteSpace=wrap;html=1;" value="基于科学的生产方式，劳动者的工作往往能事半功倍。为了社会主义建设，在改造劳工的意识之前，改造他们头脑中对工具的使用更为优先。 " vertex="1">
          <mxGeometry height="60" width="120" x="-3910" y="11000.5" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-37" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;span style=&quot;font-size: 12px;&quot;&gt;至少完成六次海报宣传&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="-2800" y="11151" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-41" edge="1" parent="1" source="t5M3M1sEbG90e6OJC7N9-38" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBackgroundColor=default;defaultLabelBackgroundColor=page;startSize=8;endArrow=classic;endSize=8;" target="t5M3M1sEbG90e6OJC7N9-40">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-38" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="至少完成九次海报宣传" vertex="1">
          <mxGeometry height="30" width="60" x="-2820" y="11265.64" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-46" parent="1" style="whiteSpace=wrap;html=1;" value="我们不需要自命不凡的精英创作。事实已经证明，只要稍加引导和调整，自发的群众路线便是革命文化的第一性。" vertex="1">
          <mxGeometry height="60" width="120" x="-1640" y="11121" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-47" parent="1" style="whiteSpace=wrap;html=1;" value="我们当然也想把研究经费提供给所有人，但面临着严峻的现实，服务于生产总好过服务于毫无作用的损耗。" vertex="1">
          <mxGeometry height="60" width="120" x="-1654" y="11000.5" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-49" parent="1" style="whiteSpace=wrap;html=1;" value="激昂的群众热情固然值得鼓励，然而我们必须审视其间的革命性质——它究竟是社会主义新文化，还是旧世界的残余？为了引导浩如烟海的群众创作，一个统一且集中的宣传窗口更有利于革命。" vertex="1">
          <mxGeometry height="60" width="120" x="-3060" y="11061" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-51" parent="1" style="whiteSpace=wrap;html=1;" value="一些看似无用科学理论，在未来或许会产生极大的质变效果，社会主义的远见，促使着我们向未来看齐。" vertex="1">
          <mxGeometry height="60" width="120" x="-3060" y="10881" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-54" parent="1" style="whiteSpace=wrap;html=1;" value="没有年轻一代的教育和生产劳动的结合，未来社会的理想是不能想象的：无论是脱离生产劳动的教学和教育，或是没有同时进行教学和教育的生产劳动，都不能达到现代技术水平和科学知识现状所要求的高度。" vertex="1">
          <mxGeometry height="60" width="120" x="-1910" y="10470" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-56" parent="1" style="whiteSpace=wrap;html=1;" value="通过吸收和改造人类思想和文化发展中有价值的东西，按照无产阶级专政的实际经验下进行工作 ……依照这种方式，我们将重新定义人类文化。" vertex="1">
          <mxGeometry height="60" width="120" x="-2860" y="10761.14" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-58" parent="1" style="whiteSpace=wrap;html=1;" value="目前的俄罗斯工会依然处于一种混乱状态。为了保证政府意志的传输，将它转化为学习与教育的共产主义学校犹为重要" vertex="1">
          <mxGeometry height="60" width="120" x="-3910" y="10761.28" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-64" edge="1" parent="1" source="t5M3M1sEbG90e6OJC7N9-61" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBackgroundColor=default;defaultLabelBackgroundColor=page;startSize=8;endArrow=classic;endSize=8;" target="t5M3M1sEbG90e6OJC7N9-62">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-61" parent="1" style="whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="60" width="120" x="-2700" y="11335.14" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-62" parent="1" style="whiteSpace=wrap;html=1;" value="社会主义的“现在”即是对共产主义明天的期待。和遥远的过去挥手再见吧，铸造钢铁的人们也会在未来被钢铁所铸造！" vertex="1">
          <mxGeometry height="60" width="120" x="-2940" y="11335.14" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-68" edge="1" parent="1" source="t5M3M1sEbG90e6OJC7N9-66" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBackgroundColor=default;defaultLabelBackgroundColor=page;startSize=8;endArrow=classic;endSize=8;" target="t5M3M1sEbG90e6OJC7N9-67">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-66" parent="1" style="whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="60" width="120" x="-1820" y="11241" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-67" parent="1" style="whiteSpace=wrap;html=1;" value="社会主义的“将来”绝非对乌托邦的幻想——是的，我们立誓，要让全人类享受应当的幸福！" vertex="1">
          <mxGeometry height="60" width="120" x="-1640" y="11241" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-72" edge="1" parent="1" source="t5M3M1sEbG90e6OJC7N9-69" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBackgroundColor=default;defaultLabelBackgroundColor=page;startSize=8;endArrow=classic;endSize=8;" target="t5M3M1sEbG90e6OJC7N9-70">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-69" parent="1" style="whiteSpace=wrap;html=1;" value="获得一个科研槽" vertex="1">
          <mxGeometry height="60" width="120" x="-1820" y="11361" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-70" parent="1" style="whiteSpace=wrap;html=1;" value="&lt;div&gt;把暴动的跺脚声砸进广场！&lt;/div&gt;&lt;div&gt;高些，再高些，一排排高傲的头颅！&lt;/div&gt;&lt;div&gt;向左！向左！向左！&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="-1640" y="11361" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-76" edge="1" parent="1" source="t5M3M1sEbG90e6OJC7N9-73" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBackgroundColor=default;defaultLabelBackgroundColor=page;startSize=8;endArrow=classic;endSize=8;" target="t5M3M1sEbG90e6OJC7N9-75">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-73" parent="1" style="whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="60" width="120" x="-3670" y="11241" as="geometry" />
        </mxCell>
        <mxCell id="t5M3M1sEbG90e6OJC7N9-75" parent="1" style="whiteSpace=wrap;html=1;" value="要塑造自为的阶级意识，必先灌输与引导先进的、共产主义的阶级观念。对人类灵魂的改造即是共产主义教育的口号。" vertex="1">
