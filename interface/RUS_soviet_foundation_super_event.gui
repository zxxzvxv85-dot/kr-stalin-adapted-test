guiTypes = {

	containerWindowType = {
		name = "RUS_soviet_foundation_super_event_window"
		position = { x = 0 y = 0 }
		size = { width = 1120 height = 650 }
		orientation = center
		origo = center
		clipping = no
		moveable = no
		background = {
			name = "RUS_soviet_foundation_super_event_background"
			spriteType = "GFX_RUS_soviet_foundation_super_event_background"
			alwaystransparent = yes
		}

		iconType = {
			name = "RUS_soviet_foundation_super_event_poster"
			position = { x = 92 y = 94 }
			spriteType = "GFX_RUS_soviet_foundation_super_event_poster"
			scale = 0.74
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "RUS_soviet_foundation_super_event_title"
			position = { x = 542 y = 111 }
			font = "hoi_24header"
			text = "stalin_form_sov.22.t"
			format = center
			maxWidth = 500
			maxHeight = 56
			fixedsize = yes
			alwaystransparent = yes
		}

		containerWindowType = {
			name = "RUS_soviet_foundation_super_event_text_viewport"
			position = { x = 548 y = 171 }
			size = { width = 492 height = 385 }
			margin = { left = 6 right = 28 top = 0 bottom = 8 }
			clipping = yes
			verticalScrollbar = "right_vertical_slider"
			scroll_wheel_factor = 0
			smooth_scrolling = yes

			# HOI4 only initialises a container scrollbar reliably when the
			# scrollable container has a background object. This transparent
			# paper is the same dummy used by Kaiserreich's long-text panels.
			background = {
				name = "RUS_soviet_foundation_super_event_text_scroll_anchor"
				spriteType = "GFX_empty_paper"
				alwaystransparent = yes
			}

			instantTextBoxType = {
				name = "RUS_soviet_foundation_super_event_declaration"
				position = { x = 0 y = 0 }
				font = "hoi_18mbs"
				text = "stalin_form_sov.22.desc"
				format = left
				maxWidth = 444
				alwaystransparent = yes
			}
		}

		buttonType = {
			name = "RUS_soviet_foundation_super_event_close"
			position = { x = 608 y = 579 }
			quadTextureSprite = "GFX_event_option_entry"
			buttonText = "RUS_soviet_foundation_super_event_button"
			buttonFont = "hoi_24header"
			clicksound = click_close
		}
	}

