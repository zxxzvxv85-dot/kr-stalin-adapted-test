spriteTypes = {
	# The game draws a unit leader trait with the sprite `GFX_trait_<trait token>`.
	# `RUS_fr_fragmented_officer_training` had no icon, so the leader window had no
	# sprite to draw for the 20+ RUS army leaders that spawn with the status trait.
	spriteType = {
		name = "GFX_trait_RUS_fr_fragmented_officer_training"
		texturefile = "gfx/interface/traits/RUS_fr_fragmented_officer_training.png"
		legacy_lazy_load = no
	}
}
