spriteTypes = {
	corneredTileSpriteType = {
		name = "GFX_frontend_bg"
		texturefile = "gfx/loadingscreens/RUS_stalin_main_menu.dds"
		borderSize = { x = 0 y = 0 }
		# Native KR / vanilla frontend canvas: 4:3, anchored centre, so a 16:9 screen
